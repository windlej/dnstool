/* dnstool TUI — Monokai theme.
   All semantic colors resolve from the registered "dnstool-monokai" theme
   (see dnstool/tui/theme.py), so every widget inherits a baked-in palette
   with no fallback to the terminal's ANSI colors. */

DnstoolApp {
  background: $background;
}

Screen {
  background: $background;
}

/* --- Common layout --- */

.screen-container {
  width: 100%;
  height: 100%;
  padding: 1 2;
  overflow: hidden;
}

.screen-container > DataTable {
  height: 1fr;
  margin-top: 1;
}

/* Shared toolbar (dashboard + diff header rows) */
.toolbar {
  width: 100%;
  height: auto;
  layout: horizontal;
  background: $panel;
  border: round $border-blurred;
  padding: 0 1;
}

.toolbar Label {
  width: 1fr;
  height: 100%;
  content-align: left middle;
  padding: 0 1;
  color: $text;
  text-style: bold;
}

.toolbar Button {
  width: auto;
  margin: 0 0 0 1;
}

/* --- Chrome: Header / Footer --- */

Header {
  background: $surface;
  color: $text;
  border-bottom: solid $border-blurred;
}

HeaderTitle {
  text-style: bold;
  color: $text;
}

HeaderIcon {
  background: transparent;
  color: $accent;
}

HeaderClock {
  background: transparent;
  color: $text-muted;
  text-opacity: 100%;
}

Footer {
  background: $surface;
  border-top: solid $border-blurred;
}

Footer > FooterKey .footer-key--key {
  color: $accent;
}

Footer > FooterKey .footer-key--description {
  color: $text-muted;
}

/* --- Panels --- */

.panel {
  background: $panel;
  border: round $border-blurred;
}

/* --- DataTable --- */

DataTable {
  background: $surface;
  color: $text;
  border: round $border-blurred;
}

DataTable:focus {
  border: round $accent;
}

DataTable > .datatable--header {
  background: $panel;
  color: $text;
  text-style: bold;
}

DataTable > .datatable--odd-row {
  background: transparent;
}

/* Keep the zebra visible and Monokai-flavored (id beats the default :dark rule). */
#dashboard-table > .datatable--even-row,
#checks-table > .datatable--even-row,
#records-table > .datatable--even-row,
#diff-table > .datatable--even-row {
  background: $panel 42%;
}

/* --- OptionList --- */

OptionList {
  background: $surface;
  color: $text;
  border: round $border-blurred;
}

OptionList:focus {
  border: round $accent;
}

OptionList > .option-list--option {
  color: $text;
}

OptionList > .option-list--option-highlighted {
  background: $accent 25%;
  color: $text;
}

OptionList > .option-list--option-hover {
  background: $panel 60%;
}

/* --- Input --- */

Input {
  background: $surface;
  color: $text;
  border: round $border-blurred;
}

Input:focus {
  border: round $accent;
}

Input > .input--placeholder {
  color: $text-muted;
}

/* --- Button --- */

Button.-style-flat,
Button.-style-default {
  background: $surface;
  color: $text;
  border: round $border-blurred;
  text-style: bold;
}

Button.-style-flat:hover,
Button.-style-default:hover {
  background: $panel;
  border: round $accent-darken-1;
  color: $text;
}

Button.-style-flat:focus,
Button.-style-default:focus {
  border: round $accent;
  text-style: $button-focus-text-style;
  background: $panel;
}

Button.-style-flat.-active,
Button.-style-default.-active {
  border: round $accent;
  tint: $background 30%;
}

Button.-style-flat:disabled,
Button.-style-default:disabled {
  color: $text-muted;
  border: round $border-blurred;
  text-style: italic;
  pointer: not-allowed;
}

Button.-style-flat.-primary,
Button.-style-default.-primary {
  background: $primary;
  border: round $primary;
  color: $button-color-foreground;
}

Button.-style-flat.-primary:hover,
Button.-style-default.-primary:hover {
  background: $primary-darken-2;
  border: round $primary-lighten-1;
}

Button.-style-flat.-error,
Button.-style-default.-error {
  background: $error 15%;
  border: round $error;
  color: $error;
}

Button.-style-flat.-error:hover,
Button.-style-default.-error:hover {
  background: $error 30%;
  border: round $error-lighten-1;
  color: $error-lighten-1;
}

Button.-style-flat.-success,
Button.-style-default.-success {
  background: $success 15%;
  border: round $success;
  color: $success;
}

Button.-style-flat.-warning,
Button.-style-default.-warning {
  background: $warning 15%;
  border: round $warning;
  color: $warning;
}

/* --- Dashboard --- */

#dashboard-table {
  height: 1fr;
}

#dashboard-empty {
  height: 1fr;
  content-align: center middle;
}

/* --- Check Screen --- */

.check-summary {
  width: 100%;
  height: auto;
  padding: 1;
  background: $panel;
  border: round $border-blurred;
  layout: horizontal;
}

.check-score {
  width: auto;
  height: auto;
  min-width: 12;
  max-width: 20;
  text-align: center;
  content-align: center middle;
  padding: 0 1;
  text-style: bold;
  color: $text;
  background: $surface;
  border: round $border-blurred;
}

.check-score.score-good {
  background: $success 22%;
  color: $success-lighten-1;
  border: round $success-darken-1;
}

.check-score.score-warn {
  background: $warning 22%;
  color: $warning-lighten-1;
  border: round $warning-darken-1;
}

.check-score.score-bad {
  background: $error 22%;
  color: $error-lighten-1;
  border: round $error-darken-1;
}

#check-title {
  width: 1fr;
  height: 100%;
  content-align: left middle;
  padding: 0 1;
  color: $text;
  text-style: bold;
}

.check-body {
  width: 100%;
  height: 1fr;
  margin-top: 1;
  layout: vertical;
}

.check-pane {
  width: 100%;
  height: 1fr;
  layout: vertical;
}

#records-pane {
  margin-top: 1;
}

/* Wide terminals: side-by-side panes */
.check-body.-split {
  layout: horizontal;
}

.check-body.-split .check-pane {
  width: 1fr;
  height: 100%;
}

.check-body.-split #records-pane {
  margin-top: 0;
  margin-left: 1;
}

.check-pane > DataTable {
  height: 1fr;
  margin-top: 0;
}

#checks-table {
  min-height: 4;
}

.check-detail-bar {
  width: 100%;
  height: auto;
  padding: 1;
  margin-top: 1;
  background: $surface;
  color: $text-muted;
  border: round $accent-darken-2;
  min-height: 3;
}

#records-title {
  color: $accent;
  text-style: bold;
  height: auto;
  margin-bottom: 1;
}

/* --- Diff Screen --- */

#snapshots-list {
  width: 100%;
  height: 1fr;
  margin-top: 1;
}

#diff-empty {
  height: 1fr;
  content-align: center middle;
}

#diff-table {
  height: 1fr;
  margin-top: 1;
}

/* --- Domain Input Modal --- */

.domain-input-container {
  width: 60;
  height: auto;
  max-width: 90%;
  padding: 2;
  background: $panel;
  border: tall $accent;
  margin: 1 2;
  layout: vertical;
}

.domain-input-container Label {
  width: 100%;
  height: auto;
  margin-bottom: 1;
  color: $text;
  text-style: bold;
}

.domain-input-container Input {
  width: 100%;
  margin-bottom: 1;
}

.domain-input-buttons {
  width: 100%;
  height: auto;
  layout: horizontal;
}

.domain-input-buttons Button {
  width: 1fr;
  margin: 0 1;
}

/* --- Backup Screen --- */

.backup-status {
  width: 100%;
  height: auto;
  padding: 1 2;
  background: $panel;
  border: round $border-blurred;
  margin-bottom: 1;
  color: $text;
  text-style: bold;
}

.backup-result {
  width: 100%;
  height: auto;
  padding: 1 2;
  background: $surface;
  border: round $border-blurred;
}

.backup-result Label {
  width: 100%;
  height: auto;
  padding: 0 1;
  color: $text;
}

/* --- Track Screen --- */

.track-section {
  width: 100%;
  height: auto;
  padding: 1;
  background: $panel;
  border: round $border-blurred;
  margin-bottom: 1;
}

.track-section Label {
  width: 100%;
  height: auto;
  margin-bottom: 1;
  color: $text;
  text-style: bold;
}

.track-input-row {
  width: 100%;
  height: auto;
  layout: horizontal;
  margin-top: 1;
}

.track-input-row Input {
  width: 1fr;
  margin-right: 1;
}

.track-input-row Button {
  width: auto;
}

#tracked-list {
  width: 100%;
  height: auto;
  margin-top: 1;
  max-height: 20;
}

#untrack-btn {
  width: 100%;
  margin-top: 1;
}

/* --- Utility --- */

.empty-state {
  width: 100%;
  height: auto;
  padding: 2 1;
  text-align: center;
  color: $text-muted;
  text-style: italic;
  background: $surface;
  border: round $border-blurred;
}

.status-ok {
  color: $success;
}

.status-warn {
  color: $warning;
}

.status-err {
  color: $error;
}

.status-info {
  color: $accent;
}